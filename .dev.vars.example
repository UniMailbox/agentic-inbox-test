# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Local development only — set your domain(s) and any pre-created mailbox addresses.
# DOMAINS supports multiple comma-separated values. The first value is the default domain.
# Example: "example.com" (single) or "example.com,foo.com,bar.com" (multiple).
DOMAINS=example.com,test.com, bar.com, list.com
EMAIL_ADDRESSES=
